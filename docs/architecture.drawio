        <mxCell id="note1" value="価格フィードが3系統:&#10;・シグナル判定 = Yahoo Finance 1時間足(yfinance, period=60d)&#10;・約定価格 = GMO ticker  ・バックテスト = HistData.com(fx_cache/)&#10;　→ トレード単位の parity 照合はこの3者の差ぶんがノイズになる(docs/PARITY.md)&#10;&#10;単一構成(冗長化なし)は意図的な判断:&#10;・1 台停止 ≒ 最悪 1 サイクル(1 時間)のシグナル欠損に留まる&#10;・Elastic IP + systemd(Restart=always) + CloudWatch ec2:recover で数分〜十数分で自動復帰&#10;・よって ALB / 多重化のコストは割に合わないと判断した&#10;・2026-08 に物理ホスト障害 → AWS CLI で stop→start しホスト移設して復旧、以後この自動復旧を追加" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fillColor=#FFF8E1;strokeColor=#E7157B;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="600" width="740" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="約定価格 / 発注 / 建玉照会" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classicThin;startArrow=classicThin;strokeColor=#666666;fontSize=10;fontColor=#666666;" edge="1" parent="1" source="ec2bot" target="gmo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e0yf" value="1時間足チャート(シグナル判定)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#4C9FFE;fontSize=10;fontColor=#4C9FFE;" edge="1" parent="1" source="yf" target="ec2bot">
