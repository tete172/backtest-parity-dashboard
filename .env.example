# ---- データベース ----
# ローカル(ゼロ設定)は SQLite。docker-compose では PostgreSQL(=RDS 相当)に上書きされる。
DATABASE_URL=sqlite:///./fxbot_dashboard.db
# 例(RDS): postgresql+psycopg2://fxbot:password@db.xxxx.ap-northeast-1.rds.amazonaws.com:5432/fxbot

# ---- キャッシュ(ElastiCache 相当)----
# 未設定ならプロセス内メモリにフォールバックする(Redis は必須依存ではない)。
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# ---- AWS / CloudWatch ----
AWS_REGION=ap-northeast-1
EC2_INSTANCE_ID=i-0123456789abcdef0
# 監視ボットの EC2 に紐づく CloudWatch アラーム名(カンマ区切り)
CLOUDWATCH_ALARM_NAMES=my-bot-SystemStatusFailed-AutoRecover,my-bot-StopAlert
# 認証は標準の boto3 解決順(~/.aws/credentials、インスタンスプロファイル等)。
# 認証情報が無い場合はダッシュボードの CloudWatch パネルだけ "利用不可" 表示になり、他機能は動く。

# ---- ログ取り込み ----
FXBOT_LOG_PATH=./ingest/sample_fxbot.log
INGEST_STATE_PATH=./.ingest_state.json

# ---- ボット死活判定 ----
BOT_CYCLE_INTERVAL_MINUTES=60
BOT_STALE_AFTER_MINUTES=150
